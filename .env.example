# GitAI Configuration
# Copy this file to .env and fill in your values

# API key for your LLM provider (Google Gemini, OpenAI, etc.)
API_KEY=your_api_key_here

# LLM model to use (format: provider/model-name)
# Examples: groq/llama-3.3-70b-versatile, gemini/gemini-2.5-flash, openai/gpt-4o
LLM_MODEL=groq/llama-3.3-70b-versatile

# Maximum output tokens for commit messages (default: 2048)
LLM_MAX_TOKENS=2048

# Enable verbose logging (true/false)
VERBOSE_LOG=true