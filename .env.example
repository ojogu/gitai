# GitAI Configuration
# Copy this file to .env and fill in your values

# API key for your LLM provider (Google Gemini, OpenAI, etc.)
API_KEY=your_api_key_here

# LLM model to use (format: provider/model-name)
# Examples: gemini/gemini-2.5-flash, openai/gpt-4o, anthropic/claude-3-opus
LLM_MODEL=gemini/gemini-2.5-flash

# Maximum output tokens for commit messages (default: 2048)
LLM_MAX_TOKENS=2048

# Enable verbose logging (true/false)
VERBOSE_LOG=true